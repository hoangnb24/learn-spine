{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-spine.local/contracts/project-v1.schema.json",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "enum": [
          "region-v0",
          "mesh-v1",
          "ik-v1"
        ]
      },
      "uniqueItems": true,
      "contains": {
        "const": "region-v0"
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "maxLength": 10000
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "bones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bone"
      },
      "minItems": 1
    },
    "slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slot"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/region"
          },
          {
            "$ref": "#/$defs/mesh"
          }
        ]
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/animation"
      }
    },
    "ikConstraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/twoBoneIK"
      }
    }
  },
  "required": [
    "formatVersion",
    "projectId",
    "revision",
    "requiredCapabilities",
    "metadata",
    "assets",
    "bones",
    "slots",
    "attachments",
    "animations"
  ],
  "additionalProperties": false,
  "$defs": {
    "transform": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "rotation": {
          "type": "number"
        },
        "scaleX": {
          "type": "number"
        },
        "scaleY": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "rotation",
        "scaleX",
        "scaleY"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "path": {
          "type": "string",
          "pattern": "^assets/[A-Za-z0-9_-]+\\.png(?![\\s\\S])"
        },
        "mimeType": {
          "const": "image/png"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "pixelWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "pixelHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "originalWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "originalHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "trimX": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trimY": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "name",
        "path",
        "mimeType",
        "sha256",
        "pixelWidth",
        "pixelHeight",
        "originalWidth",
        "originalHeight",
        "trimX",
        "trimY"
      ],
      "additionalProperties": false
    },
    "bone": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "parentId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "setup": {
          "$ref": "#/$defs/transform"
        }
      },
      "required": [
        "id",
        "name",
        "parentId",
        "setup"
      ],
      "additionalProperties": false
    },
    "slot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "boneId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
        },
        "attachmentId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "boneId",
        "attachmentId"
      ],
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
        },
        "type": {
          "const": "region"
        },
        "assetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pivotX": {
          "type": "number"
        },
        "pivotY": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "type",
        "assetId",
        "transform",
        "width",
        "height",
        "pivotX",
        "pivotY"
      ],
      "additionalProperties": false
    },
    "curve": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "linear"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "stepped"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "bezier"
            },
            "x1": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y1": {
              "type": "number"
            },
            "x2": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y2": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "x1",
            "y1",
            "x2",
            "y2"
          ],
          "additionalProperties": false
        }
      ]
    },
    "key": {
      "type": "object",
      "properties": {
        "time": {
          "type": "number",
          "minimum": 0
        },
        "value": {
          "type": "number"
        },
        "curve": {
          "$ref": "#/$defs/curve"
        }
      },
      "required": [
        "time",
        "value",
        "curve"
      ],
      "additionalProperties": false
    },
    "channel": {
      "type": "object",
      "properties": {
        "boneId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
        },
        "property": {
          "enum": [
            "x",
            "y",
            "rotation",
            "scaleX",
            "scaleY"
          ]
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "minItems": 1
        }
      },
      "required": [
        "boneId",
        "property",
        "keys"
      ],
      "additionalProperties": false
    },
    "animation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "loop": {
          "type": "boolean"
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/channel"
          }
        },
        "deforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deform"
          }
        }
      },
      "required": [
        "id",
        "name",
        "duration",
        "loop",
        "channels"
      ],
      "additionalProperties": false
    },
    "mesh": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
        },
        "type": {
          "const": "mesh"
        },
        "assetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
        },
        "vertices": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6
        },
        "uvs": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 6
        },
        "triangles": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 3
        },
        "bindPose": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "boneId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
              },
              "world": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 6,
                "maxItems": 6
              }
            },
            "required": [
              "boneId",
              "world"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "weights": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "boneId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
                },
                "weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "boneId",
                "weight"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "minItems": 3
        }
      },
      "required": [
        "id",
        "type",
        "assetId",
        "vertices",
        "uvs",
        "triangles",
        "bindPose",
        "weights"
      ],
      "additionalProperties": false
    },
    "deform": {
      "type": "object",
      "properties": {
        "attachmentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time": {
                "type": "number",
                "minimum": 0
              },
              "offsets": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 6
              },
              "curve": {
                "$ref": "#/$defs/curve"
              }
            },
            "required": [
              "time",
              "offsets",
              "curve"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "attachmentId",
        "keys"
      ],
      "additionalProperties": false
    },
    "twoBoneIK": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
        },
        "type": {
          "const": "two-bone-ik"
        },
        "rootBoneId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
        },
        "childBoneId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
        },
        "targetBoneId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
        },
        "endpoint": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "bend": {
          "enum": [
            1,
            -1
          ]
        },
        "mix": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "type",
        "rootBoneId",
        "childBoneId",
        "targetBoneId",
        "endpoint",
        "bend",
        "mix",
        "order"
      ],
      "additionalProperties": false
    }
  }
}
